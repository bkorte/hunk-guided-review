{
  "name": "hunk-guided-review",
  "version": "0.2.0",
  "description": "AI-generated review guide for Hunk: the changeset split into logical sections with explanations, generated by a coding-agent CLI (claude, codex, or pi).",
  "author": "Blaine Korte",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkorte/hunk-guided-review.git"
  },
  "keywords": [
    "hunk",
    "hunk-extension",
    "code-review",
    "claude"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "hunk": {
    "extensions": [
      "./index.tsx"
    ],
    "apiVersion": 8
  },
  "bin": {
    "hunk-guide": "./scripts/generate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate": "bun scripts/generate.ts"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "hunkdiff": "^0.20.1",
    "react": "^19.2.4",
    "typescript": "^5.9.0"
  }
}
